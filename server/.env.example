# Copy to .env and fill in secrets. Load order is fixed so these are read before auth routes.

PORT=4000
CLIENT_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string-for-signing-tokens

# Database (tracked server uses pool.js — DB_* vars, not DATABASE_URL)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=unimate
DB_USER=unimate
DB_PASSWORD=unimate

# Google OAuth 2.0 (Web application client in Google Cloud Console)
# Authorized redirect URI must include exactly this URL:
GOOGLE_CLIENT_ID=544320919470-dc5vnig55cc72aapc460hjes43ee98l3.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Optional: comma-separated domains (server auth also has a hardcoded Five College list)
ALLOWED_EMAIL_DOMAINS=umass.edu,amherst.edu,hampshire.edu,mtholyoke.edu,smith.edu

# Collaborate chat links require extra columns — applied automatically via docker-compose init,
# or run: psql "$DATABASE_URL" -f db/add_collab_chat_columns.sql
#
# If Google sign-in fails with "column full_name does not exist", your DB was created with
# the old server/db/schema.sql. Either recreate the volume (docker compose down -v && up -d)
# with 001_initial_schema.sql, or run once:
#   cd server && docker compose exec -T db psql -U unimate -d unimate < db/migrate_legacy_schema_for_oauth.sql
